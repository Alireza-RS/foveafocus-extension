{
  "manifest_version": 3,
  "name": "FoveaFocus",
  "version": "1.1.1",
  "description": "Focus-first RSVP speed reader for web pages and PDF articles: one word at a time, on a fixed mark.",
  "minimum_chrome_version": "136",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Show or hide the bar of FoveaFocus in this tab"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "scripting", "tabs", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["reader.html", "viewer.html", "pdf.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "read": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Read this page, or what is selected"
    },
    "read-from-a-place": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Pick the place in the page to read from"
    }
  }
}
